{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ResetPasswordRequest",
  "title": "ResetPasswordRequest",
  "type": "object",
  "required": [
    "method",
    "token",
    "newPassword"
  ],
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "token"
      ]
    },
    "token": {
      "type": "string"
    },
    "newPassword": {
      "type": "string",
      "format": "password"
    }
  }
}