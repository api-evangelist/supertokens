{
  "opencollection": "1.0.0",
  "info": {
    "name": "SuperTokens Core Driver Interface Email Password Health API",
    "version": "5.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Service Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/hello"
          },
          "docs": "Returns a health check response confirming the SuperTokens Core service is running."
        },
        {
          "info": {
            "name": "Get API Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/apiversion"
          },
          "docs": "Returns the supported CDI API versions for this Core instance."
        }
      ]
    }
  ],
  "bundled": true
}